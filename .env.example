# ── Database ───────────────────────────────────────────────────────────────
# Inside docker-compose the host is `db`. For running the api on your host
# against the compose Postgres, use localhost:5432.
DATABASE_URL=postgresql+psycopg://loose:loose@db:5432/looseends

# ── OpenAI ─────────────────────────────────────────────────────────────────
# Required from Phase 2 onward. Phase 1 does not touch OpenAI.
OPENAI_API_KEY=sk-...

# Model IDs live ONLY here — never hardcode a model string in application code.
# Verify these against OpenAI's current model list at build time.
# Small/cheap model for extraction; stronger model for drafting. Chosen from the
# non-reasoning GPT-4.1 generation because the pipeline relies on temperature control
# (temperature=0 for extraction, higher for drafts) which the reasoning-model families
# don't honour. Verify these against `GET /v1/models` for your account before a build.
OPENAI_MODEL_EXTRACT=gpt-4.1-mini
OPENAI_MODEL_DRAFT=gpt-4.1
OPENAI_MODEL_EMBED=text-embedding-3-small

# ── Pipeline config ──────────────────────────────────────────────────────────
# Extractions at or above this land in the ledger; below go to review.
CONFIDENCE_THRESHOLD=0.75

# Bumped whenever a prompt file changes; stored on every row a call produced.
PROMPT_VERSION=v1

# ── Web ──────────────────────────────────────────────────────────────────────
# Where the Next.js app reaches the API (browser-side). Host port is 8001 by
# default (compose maps host 8001 -> api container 8000) to avoid colliding with
# anything already on 8000. Change to 8000 if that port is free on your machine.
NEXT_PUBLIC_API_BASE=http://localhost:8001
# Where the Next.js server reaches the API (inside compose network).
API_BASE_INTERNAL=http://api:8000

# ── Demo safety (Phase 9) ─────────────────────────────────────────────────────
MAX_INPUT_CHARS=20000
INGEST_RATE_LIMIT_PER_MIN=10
